#!/usr/bin/env bash
# Terminal chat starts directly in Node; backend commands use the full Python env.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export TSAD_ROOT="$ROOT"
if [ "${1:-}" = "prepare-tui" ]; then
    shift
    exec "$ROOT/scripts/prepare-harness-tui" "$@"
fi
if [ "${1:-}" = "tui" ]; then
    shift
    if ! TUI_ENTRY="$("$ROOT/scripts/prepare-harness-tui" --print-entry)"; then
        "$ROOT/scripts/prepare-harness-tui" >&2
        TUI_ENTRY="$("$ROOT/scripts/prepare-harness-tui" --print-entry)"
    fi
    export TSAD_HARNESS_PYTHON="${TSAD_HARNESS_PYTHON:-$ROOT/envs/harness/venv/bin/python}"
    export PYTHONPATH="$ROOT/EasyTSAD/Harness${PYTHONPATH:+:$PYTHONPATH}"
    exec "${TUI_ENTRY%/dist/tui.mjs}/node" "$TUI_ENTRY" "$@"
fi
export UV_PYTHON_INSTALL_DIR="$ROOT/runtime/python"
export UV_CACHE_DIR="$ROOT/runtime/uv-cache"
export UV_PYTHON_BIN_DIR="$ROOT/runtime/python/bin"
export UV_MANAGED_PYTHON=1

PY="$ROOT/envs/harness/venv/bin/python"
if [ ! -x "$PY" ]; then
    "$ROOT/scripts/tsad" sync harness
fi
export PYTHONPATH="$ROOT/EasyTSAD/Harness${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m tsad_harness "$@"
